# Paste these two location blocks into every nginx server block that serves the app (the HTTPS one is
# required: browsers only allow the camera over HTTPS). nginx picks the longest matching prefix, so
# /drama/ wins over a catch-all `location /`. Run `nginx -t && systemctl reload nginx` afterwards.

    location = /drama {
        return 301 /drama/;
    }

    location /drama/ {
        proxy_pass http://127.0.0.1:8002/;          # trailing slash strips the /drama prefix
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /drama;  # app.py's ProxyFix turns this into url_for() prefixes
        client_max_body_size 5m;                     # face photos arrive as base64 JSON (~0.2-1 MB)
        proxy_read_timeout 120s;
    }
