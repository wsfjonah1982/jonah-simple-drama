[Unit]
Description=Site login gate for nginx auth_request (gunicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/site-auth
# One process on purpose: the failed-login throttle is kept in memory. Threads handle concurrency.
ExecStart=/opt/site-auth/venv/bin/gunicorn -w 1 --threads 4 --worker-class gthread -b 127.0.0.1:8003 auth_app:app
Restart=on-failure
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
